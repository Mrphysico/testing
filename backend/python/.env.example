# ==============================================================
# GOVERNMENT ACCIDENT DETECTION & ALERT SYSTEM CONFIGURATION
# ==============================================================

# Server Port
PORT=8000

# Security Key for JWT tokens
SECRET_KEY=gov_accident_detection_secure_secret_key_2026_xyz

# CORS Allowed Origins
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5500,http://localhost:3000

# Database Connection (Default: local SQLite database)
# For production PostgreSQL: postgresql://user:password@localhost:5432/accident_db
# DATABASE_URL=sqlite:///accident_system.db

# ==============================================================
# EMAIL SERVICE (SMTP) CONFIGURATION
# ==============================================================
# To send REAL emails to Gmail, Yahoo, Outlook, or institutional servers:
# For Gmail:
#   1. Enable 2-Step Verification in Google Account.
#   2. Go to Security -> App Passwords -> Generate App Password for "Mail".
#   3. Paste the 16-character password below into SMTP_PASSWORD.
# Note: If left blank, the system automatically uses Virtual Email Logging
# (outputs complete email in the server terminal and displays dev OTP in UI).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Government Emergency Portal
SMTP_TLS=True

# Developer Mode: In dev mode, the OTP code is logged in terminal and returned in test responses
DEV_SHOW_OTP=True

# ==============================================================
# SMS ALERTS CONFIGURATION (TWILIO)
# ==============================================================
# Optional: Twilio credentials for real SMS alerts to mobile phones.
# If left blank, Virtual SMS Gateway is active and visible in the Admin Panel.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
